# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_MAX_IDLE=5
DB_IDLE_TIMEOUT=600000

# Auth / background jobs that are not edited in Admin settings
PROJECT_VALIDITY_CACHE_TTL_MS=120000
AISENSY_TOKEN_CACHE_TTL_MS=600000
PROJECT_DATA_CACHE_TTL_MS=300000
DEVELOPER_AUTH_CACHE_TTL_MS=300000
WEBHOOK_SUBSCRIPTION_CRON=*/30 * * * *

# App URLs
BASE_DOMAIN=https://api.example.com
APP_DOMAIN=https://app.example.com

# Google Gemini AI (fallback key for auto-reply when agent_use_personal_key is off)
GEMINI_API_KEY=

# Firebase Cloud Messaging reads Server/config/firebase-service-account.json directly.
# That file is gitignored. Copy it onto the server by hand; do not commit it.

# SMTP, Razorpay, Turnstile, Google client ID, Backblaze B2, Fast2SMS,
# OneChatting send tokens, and the runtime limits are stored in the settings
# table and edited from Admin → Settings. They are copied in on first startup.
